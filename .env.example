# ==============================================================================
# Configurações do Chainlit & Banco de Dados
# ==============================================================================
# Postgres (o docker-compose.yml sobe com este padrão):
DATABASE_URL=postgresql+asyncpg://chainlit:chainlit@localhost:5432/chainlit

# Chave de sessão (gere executando `chainlit create-secret`):
CHAINLIT_AUTH_SECRET=

# Usuário e senha para autenticação local no chat:
CHAINLIT_LOCAL_USER=
CHAINLIT_LOCAL_PASSWORD=

# ==============================================================================
# Provedor de LLM (Pluggable: Ollama, OpenAI, LiteLLM, Gateways Corporativos)
# ==============================================================================
# Opção 1: Ollama Local (Padrão)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3-cpre:latest

# Opção 2: Exemplo de Gateway Corporativo ou OpenAI Oficial
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-seu-token-aqui
# LLM_MODEL=gpt-4o

# Verificação SSL (mude para false apenas se estiver em rede corporativa com proxy SSL restritivo)
LLM_VERIFY_SSL=true

# Parâmetros de Inferência (Opcionais)
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=900
