# Copie para .env e preencha. Não commite o .env com valores reais.

# Postgres local (docker-compose.yml sobe exatamente esse usuário/senha/db)
DATABASE_URL=postgresql+asyncpg://chainlit:chainlit@localhost:5432/chainlit

# Rode `chainlit create-secret` e cole o valor gerado aqui.
CHAINLIT_AUTH_SECRET=

# Único usuário local que vai poder logar e ver a sidebar.
CHAINLIT_LOCAL_USER=
CHAINLIT_LOCAL_PASSWORD=
